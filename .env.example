# ==============================================================================
# OMEGA RESEARCH GRID — Configuration
# ==============================================================================

# ── 1. LLM API Keys ────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── 2. Search Provider Keys ────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ── 3. Observability (LangSmith & OTEL) ────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=omega_research_prod
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=omega-agent-council

# ── 4. Databases ───────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omega_research
POSTGRES_USER=omega
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql+asyncpg://omega:your_password_here@localhost:5432/omega_research

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_with_32_char_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Execution Limits ──────────────────────────────────────────────────────────
MAX_SEARCH_RESULTS=20
MAX_READER_PAGES=10
MAX_RECURSION_DEPTH=5
MAX_TOTAL_TOKENS=500000
TOKEN_BUDGET_PER_TASK=100000
MAX_CONCURRENT_AGENTS=8
TASK_TIMEOUT_SECONDS=300

# ── Cost Thresholds ───────────────────────────────────────────────────────────
COST_THRESHOLD_USD=5.00
CHEAP_MODEL_THRESHOLD_USD=1.00
PREMIUM_MODEL=gpt-4o
STANDARD_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-3-haiku-20240307

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
